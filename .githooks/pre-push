#!/bin/sh
# HARD RULE: a version of the app that fails the smoke test can never be pushed (= published).
# Runs automatically on every `git push` from this computer. See tests/smoke.js.
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -f tests/smoke.js ] || [ ! -d tests/node_modules ]; then
  echo "WARNING: smoke test not set up on this computer (run: cd tests && npm install). Push allowed but UNCHECKED."
  exit 0
fi
echo "Running smoke test before push..."
if node tests/smoke.js > .smoke-last.txt 2>&1; then
  tail -2 .smoke-last.txt
  exit 0
fi
grep -v "^  PASS" .smoke-last.txt | tail -40
echo ""
echo "PUSH BLOCKED: the app failed its smoke test. Fix it, or ask Claude to fix it. Nothing was published."
exit 1
